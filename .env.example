# Strapi (the questions editor for Spark Feedback). Copy to .env.
# POSTGRES_PASSWORD must match the one in spark-feedback-api/.env (same database).
POSTGRES_PASSWORD=spark
STRAPI_ADMIN_EMAIL=admin@spark.local
STRAPI_ADMIN_PASSWORD=change-me
# Production: set your own long random values for these.
# STRAPI_APP_KEYS=key1,key2,key3,key4
# STRAPI_ADMIN_JWT_SECRET=
# STRAPI_API_TOKEN_SALT=
# STRAPI_TRANSFER_TOKEN_SALT=
# STRAPI_ENCRYPTION_KEY=
# STRAPI_JWT_SECRET=
